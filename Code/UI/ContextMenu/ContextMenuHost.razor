@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox
@attribute [SpawnMenuHost.SpawnMenuMode]
@attribute [Icon("🔍")]
@attribute [Title("#spawnmenu.mode.inspect")]
@attribute [Order( 500 )]

<root>
	
    <div class="container">

        <Inspector @ref=Inspector></Inspector>

    </div>

    <InspectWindow />
    @if ( VRMode.IsActive )
    {
        <VRInspectCard />
    }
    else
    {
        <InspectWindow Placement=@(InspectWindow.Corner.BottomRight) />
    }

    <div class="settings-bar" @ref="SettingsBar" @onmousedown=@SettingsBarPress></div>

</root>

@code
{
    public Inspector Inspector { get; private set; }
    Panel SettingsBar = default;

    public GameObject Hovered => Inspector?.Hovered;

    public HighlightOutline SelectedOutline;
    public HighlightOutline HoveredOutline;

    protected override void OnAfterTreeRender(bool firstTime)
    {
        base.OnAfterTreeRender(firstTime);

        // built here rather than on first render so it comes back after a hotload
        if ( SettingsBar.IsValid() && !SettingsBar.Children.Any() )
        {
            BuildMenuBar();
        }

        SelectedOutline ??= ObjectHighlight.Create( GameObject );
        HoveredOutline ??= ObjectHighlight.Create( GameObject );
    }

    /// <summary>
    /// The strip of settings along the top, like Garry's Mod's context menu bar. Its menus come from <see cref="IMenuBarEvent"/>.
    /// </summary>
    void BuildMenuBar()
    {
        var ev = new IMenuBarEvent.Event();
        Scene.RunEvent<IMenuBarEvent>( listener => listener.PopulateMenuBar( ev ) );

        var bar = new MenuBar();
        foreach ( var menu in ev.Menus )
        {
            bar.AddMenu( menu );
        }

        SettingsBar.AddChild( bar );
    }

    // keep clicks on the bar from selecting whatever is in the world behind it
    void SettingsBarPress( PanelEvent e )
    {
        Sandbox.UI.InputFocus.Clear();
        e.StopPropagation();
    }

    public override void Tick()
    {
        base.Tick();

        UpdateCursor();
        DrawHandles();

        SetClass( "vr", VRMode.IsActive );
        if ( VRMode.IsActive )
            UpdateLaserClick();
        else
            InspectCursor.Update( HasActive );
    }

    bool _triggerDown;

    /// <summary>
    /// In VR the laser picks what it's aimed at, straight into the world: this panel's only there for its windows, and would
    /// only get the click where the laser happened to cross it. The windows still take their own clicks.
    /// </summary>
    void UpdateLaserClick()
    {
        var down = Input.Down( "attack1" );
        var pressed = down && !_triggerDown;
        var released = !down && _triggerDown;
        _triggerDown = down;

        if ( released ) InspectCursor.Release();

        if ( pressed && InspectCursor.IsOpen && !VRHud.IsPointing )
        {
            Sandbox.UI.InputFocus.Clear();
            Inspector?.SelectObject( Inspector.Hovered );

            if ( Inspector?.Hovered.IsValid() == true )
                InspectCursor.Press();
        }

        InspectCursor.Update( down );
    }

    protected override void OnVisibilityChanged()
    {
        base.OnVisibilityChanged();
        InspectCursor.Release();
    }

    void UpdateCursor()
    {
        Style.Cursor = (Inspector?.Hovered.IsValid() ?? false) ? "pointer" : null;
    }

    protected override void OnMouseDown(MousePanelEvent e)
    {
        Sandbox.UI.InputFocus.Clear();

        // A press only gets here from the windows in VR, see UpdateLaserClick: it isn't a pick of what's behind them
        if ( VRMode.IsActive ) return;

        if ( e.MouseButton == MouseButtons.Right )
        {
            // right click while dragging with the physgun freezes instead
            if ( InspectCursor.RequestFreeze() ) return;

            Inspector?.WorldMouseRightDown( e );
            return;
        }

        Inspector?.WorldMouseDown( e );

        if ( e.MouseButton == MouseButtons.Left && Inspector?.Hovered.IsValid() == true )
            InspectCursor.Press();
    }

    protected override void OnMouseUp(MousePanelEvent e)
    {
        if ( e.MouseButton == MouseButtons.Left )
            InspectCursor.Release();
    }

    Dictionary<Component, Panel> _handles = [];

    void DrawHandles()
    {
		if ( Scene?.Camera is not { IsValid: true } )
			return;

        var objects = Scene.FindInPhysics(new Sphere( Scene.Camera.WorldPosition, 1000 ));
        var rootObjects = objects.Select( x => x.Network?.RootGameObject ).Where( x => x.IsValid() ).Distinct();

        foreach ( var o in rootObjects )
        {
            // find handles in this object
            foreach (var component in o.GetComponentsInChildren<Component>())
            {
                if (!ShouldCreateHandle(component))
                    continue;

                if ( _handles.TryGetValue(component, out var existingHandle) )
                {
                    if (existingHandle.IsValid())
                        continue;
                }

                var panel = new ComponentHandle( this, component, Inspector );
                _handles[component] = panel;
            }
        }
    }

    bool ShouldCreateHandle(Component component)
    {
        // TODO - needs a handle

        return false;
    }

}
