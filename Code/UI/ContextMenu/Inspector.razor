@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits Panel

<root>

	<div class="canvas" @ref=_canvas></div>

</root>

@code
{
    public GameObject Hovered => hovered;

    Panel _canvas = default;

    protected override int BuildHash() => HashCode.Combine( hovered, _selected.Count );

    public override void Tick()
    {
        _selected.RemoveWhere( x => !x.IsValid() );
        UpdateHighlights();
        UpdateCursor();
    }

    protected override void OnVisibilityChanged()
    {
        UpdateHighlights();
    }

    void UpdateHighlights()
    {
        var host = Ancestors.OfType<ContextMenuHost>().FirstOrDefault();
        if ( host is null ) return;

        if ( !IsVisible )
        {
            host.SelectedOutline.Hide();
            host.HoveredOutline.Hide();
            return;
        }

        host.SelectedOutline.Show( _selected, HighlightStyle.Selected );

        // Something already selected keeps its selection outline when hovered
        host.HoveredOutline.Show( _selected.Contains( hovered ) ? null : hovered, HighlightStyle.Hovered );
    }

    GameObject hovered;

    HashSet<GameObject> _selected = new();

    public IReadOnlyCollection<GameObject> Selected => _selected;

    void UpdateCursor()
    {
        var screenRay = InspectCursor.Ray;
        var tr = Scene.Trace.Ray( screenRay, 4096 )
                            .IgnoreGameObjectHierarchy( Player.FindLocalPlayer()?.GameObject )
                            .Run();

        var go = tr.Collider?.GameObject ?? tr.GameObject;
        go = go.FindNetworkRoot();

        if ( !CanSelect( go ) ) go = null;

        // In VR things with nothing to hit get no icon to click, see ContextMenuHost.DrawHandles: the laser goes near them
        if ( VRMode.IsActive && HandleAlong( screenRay, go.IsValid() ? tr.Distance : float.MaxValue ) is { } handle )
        {
            // its own object, not its network root, like a click on its icon
            if ( hovered != handle.GameObject )
            {
                hovered = handle.GameObject;
                PlaySound( "ui.button.over" );
            }

            return;
        }

        UpdateHovered( go );
    }

    /// <summary>
    /// How far off the laser, in degrees, an <see cref="IInspectHandle"/> still counts as aimed at.
    /// </summary>
    const float HandleAngle = 3f;

    /// <summary>
    /// The inspect handle nearest the laser, in front of what it hits.
    /// </summary>
    Component HandleAlong( Ray ray, float hitDistance )
    {
        Component best = null;
        var bestAngle = HandleAngle;

        foreach ( var component in InspectHandles.GetVisible( Scene ) )
        {
            var offset = component.WorldPosition - ray.Position;
            var distance = offset.Length;
            if ( distance > ComponentHandle.MaxDistance || distance > hitDistance ) continue;

            var angle = Vector3.GetAngle( ray.Forward, offset );
            if ( angle >= bestAngle ) continue;

            best = component;
            bestAngle = angle;
        }

        return best;
    }

    bool CanSelect( GameObject o )
    {
        if ( !o.IsValid() ) return false;
        if ( o.Tags.Has( "world" ) ) return false;
        if ( o.NetworkMode == NetworkMode.Never ) return false;

        o = o?.FindNetworkRoot();

        return true;
    }

    void UpdateHovered( GameObject o )
    {
        o = o?.FindNetworkRoot();

        if ( hovered == o ) return;

        hovered = o;
        PlaySound( "ui.button.over" );
    }


    public void WorldMouseDown(MousePanelEvent e)
    {
        SelectObject( hovered );
    }

    public void WorldMouseRightDown(MousePanelEvent e)
    {
        OpenContextMenu( hovered );
    }

    /// <summary>
    /// Select the object and open its right-click menu under the mouse.
    /// </summary>
    public void OpenContextMenu( GameObject target )
    {
        if ( !target.IsValid() ) return;

        SelectObject( target );

        var ev = new IContextMenuEvent.Event( target );
        Scene.RunEvent<IContextMenuEvent>( listener => listener.PopulateContextMenu( ev ) );
        if ( !ev.Options.Any() ) return;

        var menu = new Sandbox.UI.Menu();
        ev.Populate( menu );

        menu.Open( this, Popup.PositionMode.UnderMouse );
    }

    /// <summary>
    /// Picking adds to the selection, or takes off what's already in it. For VR, where there's no key to hold while aiming.
    /// </summary>
    public bool MultiSelect { get; set; }

    public void SelectObject( GameObject o )
    {
        if ( MultiSelect )
        {
            if ( o.IsValid() && !_selected.Remove( o ) )
                _selected.Add( o );

            return;
        }

        if ( !o.IsValid() )
        {
            _selected.Clear();
        }
        else
        {
            if ( !Input.Down( "run" ) )
            {
                _selected.Clear();
            }

            _selected.Add( o );
        }
    }
}


